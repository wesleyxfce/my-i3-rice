[global]
    monitor = 0
    follow = mouse
    origin = top-right

    width = 320
    height = 100
    offset = 15x45

    padding = 12
    horizontal_padding = 12

    font = JetBrainsMono Nerd Font 10

    frame_width = 2
    corner_radius = 10

    transparency = 10

    separator_height = 2

    idle_threshold = 120

[urgency_low]
    background = "#282A36"
    foreground = "#F8F8F2"
    frame_color = "#6272A4"
    timeout = 5

[urgency_normal]
    background = "#282A36"
    foreground = "#F8F8F2"
    frame_color = "#BD93F9"
    timeout = 5

[urgency_critical]
    background = "#282A36"
    foreground = "#F8F8F2"
    frame_color = "#FF5555"
    timeout = 0
